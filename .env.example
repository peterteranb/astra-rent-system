# Copia este archivo como .env y cambia los valores. El archivo .env no se sube a git.

# Base de datos: la misma contraseña que usaste al crear el usuario astra.
DB_NAME=astra_rent
DB_USER=astra
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# Seguridad. SECRET_KEY es obligatoria con DEBUG=False. Con DEBUG=True esta sirve; antes de publicar el sitio
# reemplázala por una propia: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-por-una-propia-antes-de-publicar-el-sitio-2026
# True para usarlo en tu máquina. En producción va False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Solo si entras por otro dominio con HTTPS, por ejemplo https://renta.sergiocorp.com
CSRF_TRUSTED_ORIGINS=
# True solo si el sitio está detrás de HTTPS: activa cookies seguras, redirección y HSTS.
USE_HTTPS=False

# Correo (opcional). Vacío: los correos se imprimen en la consola.
# Con Gmail: tu correo y una contraseña de aplicación de 16 letras (no la de tu cuenta).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
