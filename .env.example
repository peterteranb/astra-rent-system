# Copia este archivo como .env y cambia los valores. El archivo .env no se sube a git.

# Base de datos. Con Docker, DB_HOST lo pone docker-compose.yml.
DB_NAME=astra_rent
DB_USER=astra
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# Seguridad. SECRET_KEY es obligatoria con DEBUG=False. Antes de publicar el sitio
# reemplázala por una propia: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-por-una-propia-antes-de-publicar-el-sitio-2026
# False en producción. Para programar en tu máquina, pon True.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Solo si entras por otro dominio con HTTPS, por ejemplo https://renta.sergiocorp.com
CSRF_TRUSTED_ORIGINS=
# True solo si el sitio está detrás de HTTPS: activa cookies seguras, redirección y HSTS.
USE_HTTPS=False

# Puerto de la máquina para Docker (cámbialo si Windows tiene reservado el 8000).
WEB_PORT=8000

# Correo (opcional). Vacío: los correos se imprimen en la consola.
# Con Gmail: tu correo y una contraseña de aplicación de 16 letras (no la de tu cuenta).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
